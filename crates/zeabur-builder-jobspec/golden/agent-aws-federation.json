            "builder.zeabur.com/build": "api",
            "builder.zeabur.com/builder": "agent",
            "builder.zeabur.com/buildrun": "api-x7k2p"
          }
        },
        "spec": {
          "automountServiceAccountToken": false,
          "containers": [
            {
              "command": [
                "zeabur-builder-job",
                "build",
                "/etc/zeabur-builder/build-plan/plan.json"
