                }
              ],
              "image": "ghcr.io/zeabur-oss/builder-job:v0.0.1",
              "name": "build",
              "resources": {
                "limits": {
                  "memory": "512Mi"
                },
                "requests": {
                  "memory": "128Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true
              },
              "terminationMessagePath": "/dev/termination-log",
