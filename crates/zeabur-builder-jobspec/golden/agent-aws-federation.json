      "template": {
        "metadata": {
          "annotations": {
            "builder.zeabur.com/image": "registry.internal/team-a/api",
            "builder.zeabur.com/revision": "3e1a9c2d4f0b5a6c7d8e9f0a1b2c3d4e5f6a7b8c"
