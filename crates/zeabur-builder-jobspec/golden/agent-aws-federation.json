            {
              "name": "buildkit-client-tls",
              "secret": {
                "defaultMode": 288,
                "optional": false,
                "secretName": "zeabur-builder-buildkit-client"
              }
            },
            {
              "name": "registry-auth",
              "secret": {
                "defaultMode": 288,
                "items": [
                  {
                    "key": ".dockerconfigjson",
                    "path": "config.json"
                  }
