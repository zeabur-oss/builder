[
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "labels": {
        "app.kubernetes.io/managed-by": "zeabur-builder",
        "app.kubernetes.io/name": "buildkitd",
        "builder.zeabur.com/namespace": "team-a"
      },
      "name": "buildkitd-team-a",
      "namespace": "builder-system"
    },
    "spec": {
      "clusterIP": "None",
      "ports": [
        {
          "name": "grpc",
          "port": 1234
        }
      ],
      "selector": {
        "app.kubernetes.io/name": "buildkitd",
        "builder.zeabur.com/namespace": "team-a"
      }
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "StatefulSet",
    "metadata": {
      "labels": {
        "app.kubernetes.io/managed-by": "zeabur-builder",
        "app.kubernetes.io/name": "buildkitd",
        "builder.zeabur.com/namespace": "team-a"
      },
      "name": "buildkitd-team-a",
      "namespace": "builder-system"
    },
    "spec": {
      "persistentVolumeClaimRetentionPolicy": {
        "whenDeleted": "Delete",
        "whenScaled": "Retain"
      },
      "podManagementPolicy": "Parallel",
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/name": "buildkitd",
          "builder.zeabur.com/namespace": "team-a"
        }
      },
      "serviceName": "buildkitd-team-a",
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/managed-by": "zeabur-builder",
            "app.kubernetes.io/name": "buildkitd",
            "builder.zeabur.com/namespace": "team-a"
          }
        },
        "spec": {
          "automountServiceAccountToken": false,
          "containers": [
            {
              "args": [
                "--config=/etc/buildkit/buildkitd.toml",
                "--addr=unix:///run/buildkit/buildkitd.sock",
                "--addr=tcp://0.0.0.0:1234",
                "--tlscacert=/certs/ca.pem",
                "--tlscert=/certs/cert.pem",
                "--tlskey=/certs/key.pem"
              ],
              "command": [
                "/bin/sh",
                "-c",
                "if iptables -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu; then\n  echo \"RUN steps: TCP MSS clamped to the route MTU (eth0: $(cat /sys/class/net/eth0/mtu))\"\nelse\n  echo 'warning: cannot clamp the TCP MSS of RUN steps; they may hang where the Pod MTU is under 1500' >&2\nfi\nexec buildkitd \"$@\"",
                "buildkitd"
              ],
              "image": "docker.io/moby/buildkit:v0.34.1",
              "livenessProbe": {
                "exec": {
                  "command": [
                    "buildctl",
                    "--addr",
                    "unix:///run/buildkit/buildkitd.sock",
                    "debug",
                    "workers"
                  ]
                },
                "initialDelaySeconds": 10,
                "periodSeconds": 30
              },
              "name": "buildkitd",
              "ports": [
                {
                  "containerPort": 1234,
                  "name": "grpc"
                }
              ],
              "readinessProbe": {
                "exec": {
                  "command": [
                    "buildctl",
                    "--addr",
                    "unix:///run/buildkit/buildkitd.sock",
                    "debug",
                    "workers"
                  ]
                },
                "initialDelaySeconds": 1,
                "periodSeconds": 2
              },
              "resources": {
                "limits": {
                  "memory": "4Gi"
                },
                "requests": {
                  "cpu": "100m",
                  "memory": "256Mi"
                }
              },
              "securityContext": {
                "privileged": true
              },
              "volumeMounts": [
                {
                  "mountPath": "/etc/buildkit",
                  "name": "config",
                  "readOnly": true
                },
                {
                  "mountPath": "/certs",
                  "name": "certs",
                  "readOnly": true
                },
                {
                  "mountPath": "/var/lib/buildkit",
                  "name": "cache"
                }
              ]
            }
          ],
          "enableServiceLinks": false,
          "hostUsers": false,
          "volumes": [
            {
              "configMap": {
                "name": "buildkitd"
              },
              "name": "config"
            },
            {
              "name": "certs",
              "secret": {
                "defaultMode": 256,
                "items": [
                  {
                    "key": "ca.pem",
                    "path": "ca.pem"
                  },
                  {
                    "key": "cert.pem",
                    "path": "cert.pem"
                  },
                  {
                    "key": "key.pem",
                    "path": "key.pem"
                  }
                ],
                "secretName": "buildkitd-team-a-tls"
              }
            }
          ]
        }
      },
      "volumeClaimTemplates": [
        {
          "apiVersion": "v1",
          "kind": "PersistentVolumeClaim",
          "metadata": {
            "name": "cache"
          },
          "spec": {
            "accessModes": [
              "ReadWriteOnce"
            ],
            "resources": {
              "requests": {
                "storage": "20Gi"
              }
            }
          }
        }
      ]
    }
  },
  {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "NetworkPolicy",
    "metadata": {
      "labels": {
        "app.kubernetes.io/managed-by": "zeabur-builder",
        "app.kubernetes.io/name": "buildkitd",
        "builder.zeabur.com/namespace": "team-a"
      },
      "name": "buildkitd-team-a",
      "namespace": "builder-system"
    },
    "spec": {
      "ingress": [
        {
          "from": [
            {
              "namespaceSelector": {
                "matchLabels": {
                  "kubernetes.io/metadata.name": "team-a"
                }
              }
            }
          ],
          "ports": [
            {
              "port": 1234,
              "protocol": "TCP"
            }
          ]
        }
      ],
      "podSelector": {
        "matchLabels": {
          "app.kubernetes.io/name": "buildkitd",
          "builder.zeabur.com/namespace": "team-a"
        }
      },
      "policyTypes": [
        "Ingress"
      ]
    }
  }
]
