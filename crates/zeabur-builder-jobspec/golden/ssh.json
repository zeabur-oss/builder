    ]
  },
  "spec": {
    "activeDeadlineSeconds": 3600,
    "backoffLimit": 0,
    "template": {
      "metadata": {
        "annotations": {
          "builder.zeabur.com/revision": "3e1a9c2d4f0b5a6c7d8e9f0a1b2c3d4e5f6a7b8c"
        },
        "labels": {
          "app.kubernetes.io/managed-by": "zeabur-builder",
          "builder.zeabur.com/build": "api",
          "builder.zeabur.com/builder": "dockerfile",
          "builder.zeabur.com/buildrun": "api-x7k2p"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "command": [
              "zeabur-builder-job",
              "--",
              "buildctl",
              "--addr",
              "tcp://buildkitd-team-a-0.buildkitd-team-a.builder-system.svc:1234",
              "--tlsdir",
              "/etc/zeabur-builder/buildkit",
              "build",
              "--progress",
              "rawjson",
              "--metadata-file",
              "/workspace/out/metadata.json",
              "--local",
              "context=/workspace/src",
              "--frontend",
              "dockerfile.v0",
              "--local",
              "dockerfile=/workspace/src",
              "--opt",
              "filename=Dockerfile",
              "--output",
              "type=image,\"name=registry.internal/team-a/api:main-1761058800-3e1a9c2,registry.internal/team-a/api:latest\",push=true,oci-mediatypes=true,annotation.org.opencontainers.image.source=https://git.example.com/team/api,annotation.org.opencontainers.image.revision=3e1a9c2d4f0b5a6c7d8e9f0a1b2c3d4e5f6a7b8c"
            ],
            "env": [
              {
                "name": "HOME",
                "value": "/tmp"
              },
              {
                "name": "DOCKER_CONFIG",
                "value": "/etc/zeabur-builder/registry"
              }
            ],
            "image": "ghcr.io/zeabur-oss/builder-job:v0.0.1",
            "name": "build",
            "resources": {
              "limits": {
                "memory": "512Mi"
              },
              "requests": {
                "memory": "128Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "readOnlyRootFilesystem": true
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/workspace",
                "name": "workspace"
              },
              {
                "mountPath": "/tmp",
                "name": "tmp"
              },
              {
                "mountPath": "/etc/zeabur-builder/buildkit",
                "name": "buildkit-client-tls",
                "readOnly": true
              },
              {
                "mountPath": "/etc/zeabur-builder/registry",
                "name": "registry-auth",
                "readOnly": true
              }
            ]
          }
        ],
        "enableServiceLinks": false,
        "initContainers": [
          {
            "args": [
              "git@git.example.com:team/api.git",
              "3e1a9c2d4f0b5a6c7d8e9f0a1b2c3d4e5f6a7b8c"
            ],
            "command": [
              "sh",
              "-c",
              "set -eu\nstart=$(date +%s)\nmkdir -p /workspace/plan /workspace/out\nif [ -f /etc/zeabur-builder/git/ssh-privatekey ]; then\n  install -m 0600 /etc/zeabur-builder/git/ssh-privatekey /tmp/id\n  export GIT_SSH_COMMAND=\"ssh -i /tmp/id -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/zeabur-builder/git/known_hosts\"\nfi\nif [ -f /etc/zeabur-builder/git/password ]; then\n  git config --global credential.helper '!f() { echo username=$(cat /etc/zeabur-builder/git/username); echo password=$(cat /etc/zeabur-builder/git/password); }; f'\nfi\ngit init -q /workspace/src\ngit -C /workspace/src fetch -q --depth=1 --no-tags -- \"$1\" \"$2\"\ngit -C /workspace/src checkout -q --detach FETCH_HEAD\ntest \"$(git -C /workspace/src rev-parse HEAD)\" = \"$2\"\necho \"{\\\"fetch\\\":$(( $(date +%s) - start ))}\" > /workspace/out/fetch.json\n",
              "fetch"
            ],
            "env": [
              {
                "name": "HOME",
                "value": "/tmp"
              },
              {
                "name": "GIT_TERMINAL_PROMPT",
                "value": "0"
              },
              {
                "name": "GIT_CONFIG_NOSYSTEM",
                "value": "1"
              },
              {
                "name": "GIT_ALLOW_PROTOCOL",
                "value": "https:http:ssh:git"
              }
            ],
            "image": "ghcr.io/zeabur-oss/builder-job:v0.0.1",
            "name": "fetch",
            "resources": {
              "limits": {
                "memory": "512Mi"
              },
              "requests": {
                "memory": "128Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "readOnlyRootFilesystem": true
            },
            "terminationMessagePolicy": "FallbackToLogsOnError",
            "volumeMounts": [
              {
                "mountPath": "/workspace",
                "name": "workspace"
              },
              {
                "mountPath": "/tmp",
                "name": "tmp"
              },
              {
                "mountPath": "/etc/zeabur-builder/git",
                "name": "git-credentials",
                "readOnly": true
              }
            ]
          }
        ],
        "restartPolicy": "Never",
        "securityContext": {
          "fsGroup": 1000,
          "runAsGroup": 1000,
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "volumes": [
          {
            "emptyDir": {},
            "name": "workspace"
          },
          {
            "emptyDir": {},
            "name": "tmp"
          },
          {
            "name": "git-credentials",
            "secret": {
              "defaultMode": 288,
              "optional": false,
              "secretName": "deploy-key"
            }
          },
          {
            "name": "buildkit-client-tls",
            "secret": {
              "defaultMode": 288,
              "optional": false,
              "secretName": "zeabur-builder-buildkit-client"
            }
          },
          {
            "name": "registry-auth",
            "secret": {
              "defaultMode": 288,
              "items": [
                {
                  "key": ".dockerconfigjson",
                  "path": "config.json"
                }
              ],
              "optional": false,
              "secretName": "api-x7k2p-registry"
            }
          }
        ]
      }
    },
    "ttlSecondsAfterFinished": 600
  }
}
