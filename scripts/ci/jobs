# The CI jobs: scripts/ci.sh and zeabur-oss/.github README.md say what the settings mean.
# Text the code doesn't read: docs/, the change files and the top-level Markdown. README.md stays
# in, since crates/zeabur-builder/Cargo.toml names it as the crate's readme.
*               rust-cache=true skip-if-only=docs/*,.changeset/*,CHANGELOG.md,CONTRIBUTING.md
# The short checks run one after another: each needs about a minute to set up a runner and its dev
# shell but much less to run.
lint
format          in=lint
clippy          in=lint
docs            in=lint
cargo-deny      in=lint
levels          in=lint
chart           in=lint
test
kubernetes      tier=merge
